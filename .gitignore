# ====== Secrets (ne jamais versionner) ======
.env
.env.*
!.env.example
!**/.env.example

# ====== Node / Vite (frontend) ======
frontend/node_modules/
frontend/dist/

# ====== Backend (Laravel/PHP) ======
backend/vendor/
backend/storage/logs/
# storage/framework : dossiers versionnés via leurs .gitignore internes (contenu ignoré)
backend/storage/debugbar/

# ====== Laravel / tooling (chemins usuels) ======
vendor/
node_modules/
storage/logs/
public/hot
public/storage
bootstrap/cache/

# ====== Général ======
dist/
.DS_Store
Thumbs.db

# IDE
.vscode/

# ====== Outils locaux / Cursor / IA ======
.agent/
.agents/
.claude/
.windsurf/
skills-lock.json

# Git imbriqué (évite de traiter backend/ comme un sous-module)
backend/.git/
backend/**/.git/

# Git temporaire (interne au push, ne pas versionner)
backend/.git_temp/
backend/**/.git_temp/
frontend/.env.production

