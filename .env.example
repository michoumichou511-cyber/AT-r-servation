# Monorepo AT Réservations — pas de secrets ici.
#
# Backend (Laravel) : copier ce fichier vers backend/.env
#   cp backend/.env.example backend/.env
#   puis : php artisan key:generate
#
# Frontend (Vite) : copier vers frontend/.env
#   cp frontend/.env.example frontend/.env
#
# Les clés détaillées sont dans :
#   - backend/.env.example
#   - frontend/.env.example
