{
  "mcpServers": {
    "word-document-server": {
      "command": "C:\\Users\\loulou\\AppData\\Roaming\\Python\\Python314\\Scripts\\uvx.exe",
      "args": ["--from", "office-word-mcp-server", "word_mcp_server"]
    },
    "document-generator": {
      "command": "C:\\Users\\loulou\\AppData\\Roaming\\npm\\document-generator-mcp.cmd"
    },
    "drawio": {
      "type": "http",
      "url": "https://mcp.draw.io/mcp"
    },
    "uml-mcp": {
      "type": "http",
      "url": "https://uml-mcp.vercel.app/mcp"
    },
    "mermaid": {
      "command": "npx",
      "args": ["-y", "mermaid-live-mcp"]
    },
    "higgsfield": {
      "type": "http",
      "url": "https://mcp.higgsfield.ai/mcp"
    },
    "imagine": {
      "type": "http",
      "url": "https://mcp.imagine.art/mcp"
    },
    "invideo": {
      "type": "sse",
      "url": "https://mcp.invideo.io/sse"
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["chrome-devtools-mcp@latest"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "mysql": {
      "command": "npx",
      "args": ["-y", "@benborla29/mcp-server-mysql"],
      "env": {
        "MYSQL_HOST": "127.0.0.1",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "root",
        "MYSQL_PASS": "",
        "MYSQL_DB": "at_reservations",
        "ALLOW_INSERT_OPERATION": "false",
        "ALLOW_UPDATE_OPERATION": "false",
        "ALLOW_DELETE_OPERATION": "false"
      }
    }
  }
